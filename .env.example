# Copy this file to .env in the project root for local runs.
# On Render: Dashboard -> your service -> Environment -> add GEMINI_API_KEY.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Where filed complaint folders live. Defaults to ./complaints in the repo.
# On Render set this to a Persistent Disk path (e.g. /data/complaints) so
# citizen submissions are not wiped when the free instance restarts.
COMPLAINTS_DIR=
